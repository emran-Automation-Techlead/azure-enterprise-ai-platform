# Azure OpenAI / AI Foundry
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=enterprise-kb-index

# Azure AI Content Safety (optional: defaults to the Azure OpenAI endpoint and key)
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=

# Azure Blob Storage (document source; accessed with your Azure login, no storage key)
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=enterprise-docs

# Application Insights (optional locally)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Cloud only: client ID of the user-assigned managed identity (set by the deployment, not needed locally)
AZURE_CLIENT_ID=
